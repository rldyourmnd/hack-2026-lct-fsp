[Unit]
Description=FSP career API (Rust backend)
After=network.target postgresql.service fsp-interview.service

[Service]
Type=simple
User=fsp
Group=fsp
Environment=HOST=127.0.0.1
Environment=PORT=4010
EnvironmentFile=-/etc/fsp/rust-api.env
EnvironmentFile=-/etc/fsp/db.env
EnvironmentFile=-/etc/fsp/llm.env
EnvironmentFile=-/etc/fsp/interview.env
Environment=FSP_INTERVIEW_URL=http://127.0.0.1:4040
StateDirectory=fsp
ExecStart=/opt/fsp/current/bin/fsp-career-api
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
LockPersonality=yes
MemoryMax=1G

[Install]
WantedBy=multi-user.target
