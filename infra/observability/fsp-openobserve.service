[Unit]
Description=FSP private OpenObserve
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=fsp-observe
Group=fsp-observe
EnvironmentFile=/etc/fsp/observability.env
ExecStart=/opt/fsp-observability/bin/openobserve
WorkingDirectory=/var/lib/fsp-observe
StateDirectory=fsp-observe
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
MemoryHigh=2G
MemoryMax=3G
CPUQuota=200%
TasksMax=512

[Install]
WantedBy=multi-user.target
