[Unit]
Description=FSP scoped telemetry shipper
After=network.target fsp-openobserve.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
User=fsp-vector
Group=fsp-vector
SupplementaryGroups=systemd-journal adm
ExecStartPre=/opt/fsp-observability/bin/vector validate --skip-healthchecks /etc/fsp/vector.yaml
ExecStart=/opt/fsp-observability/bin/vector --config /etc/fsp/vector.yaml
StateDirectory=fsp-vector
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
MemoryMax=256M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
