# Root credentials are generated on the host; never copy them into this file.
ZO_HTTP_ADDR=127.0.0.1
ZO_HTTP_PORT=5080
ZO_GRPC_ADDR=127.0.0.1
ZO_GRPC_PORT=5081
ZO_LOCAL_MODE=true
ZO_LOCAL_MODE_STORAGE=disk
ZO_DATA_DIR=/var/lib/fsp-observe/data/
ZO_WEB_URL=http://127.0.0.1:5080
ZO_TELEMETRY=false
ZO_RUM_ENABLED=false
ZO_TRACING_ENABLED=false
ZO_EVENTS_ENABLED=false
ZO_MMDB_DISABLE_DOWNLOAD=true
ZO_CHROME_ENABLED=false
ZO_CHROME_AUTO_DOWNLOAD=false
ZO_COMPACT_DATA_RETENTION_DAYS=14
ZO_COMPACT_DATA_RETENTION_HISTORY=false
ZO_COMPACT_FAST_MODE=false
ZO_MEM_TABLE_MAX_SIZE=128
ZO_MAX_FILE_SIZE_IN_MEMORY=32
ZO_MEMORY_CACHE_ENABLED=false
ZO_MEMORY_CACHE_MAX_SIZE=128
ZO_MEMORY_CACHE_DATAFUSION_MAX_SIZE=512
ZO_HTTP_WORKER_NUM=2
ZO_GRPC_RUNTIME_WORKER_NUM=2
ZO_JSON_LIMIT=4194304
ZO_PAYLOAD_LIMIT=4194304
ZO_CORS_ALLOWED_ORIGINS=https://nddev.link,http://127.0.0.1:5080
ZO_PROMETHEUS_ENABLED=true
ZO_LOG_JSON_FORMAT=true
ZO_PRINT_KEY_CONFIG=false
ZO_PRINT_KEY_SQL=false
RUST_LOG=warn
