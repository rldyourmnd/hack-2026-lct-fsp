# PostgreSQL — the only supported datastore.
# POSTGRES_PASSWORD is required by docker compose; DATABASE_URL feeds `just backend`.
# POSTGRES_PASSWORD=<local dev password, default "fsp" matches the compose service>
# Host run (`just backend`); the compose db service publishes 127.0.0.1:5434:
# DATABASE_URL=postgres://fsp:fsp@127.0.0.1:5434/fsp
# Admin connection used by backend tests to create isolated fsp_test_* databases:
# FSP_TEST_DATABASE_URL=postgres://fsp:fsp@127.0.0.1:5434/postgres

# Optional LLM chain for the backend: Bifrost gateway in front of CLIProxyAPI providers.
# Loaded automatically by `just` (dotenv-load) for bare-metal runs such as `just backend`,
# and by docker compose for `${...}` interpolation. Never commit a filled .env (it is ignored).
#
# Host run (`just backend`, `cargo run`):
# BIFROST_CHAT_URL=http://127.0.0.1:4000/v1/chat/completions
# Container run (`just docker-up`); the api service maps host.docker.internal already:
# BIFROST_CHAT_URL_DOCKER=http://host.docker.internal:4000/v1/chat/completions
#
# BIFROST_API_KEY=<virtual key, e.g. the nddev-runtime vk-... value>
# BIFROST_MODEL=grok-build/grok-4.7
# INTERVIEW_API_TOKEN=<private token shared only by the platform and interview services>
# FSP_INTERVIEW_URL=http://127.0.0.1:4040
# INTERVIEW_BIFROST_MODEL=grok-build/grok-4.7

# Optional neural voice for interview questions. With `browser` or an unset provider,
# the frontend selects an installed Russian browser voice and keeps the offline path.
# FSP_TTS_PROVIDER=xai
# XAI_API_KEY=<xAI API key>
# XAI_TTS_VOICE=eve
#
# Domestic alternative:
# FSP_TTS_PROVIDER=yandex
# YANDEX_SPEECHKIT_API_KEY=<restricted SpeechKit API key>
# YANDEX_TTS_VOICE=marina
# YANDEX_TTS_ROLE=good
# YANDEX_TTS_MODEL=<only for a custom/Brand Voice model>

# Grade-change cooldown surfaced as assessmentPolicy.successfulGradeChangeCooldownDays
# in /api/v1/meta; 0-365 days, default 90.
# FSP_GRADE_CHANGE_COOLDOWN_DAYS=90

# Real email (optional locally; configured privately on the HTTPS stand).
# Demo mode defaults to the disclosed 123456 code. Resend mode requires every value below.
# FSP_AUTH_MODE=resend
# FSP_AUTH_KEY=<32 random bytes encoded as 64 hex characters>
# RESEND_API_KEY=<domain-restricted sending key>
# FSP_EMAIL_FROM=login@auth.nddev.link
# FSP_PUBLIC_WEB_URL=https://nddev.link
# FSP_ALLOWED_ORIGINS=https://nddev.link
# FSP_SECURE_COOKIE=1  # HTTPS only; leave 0 for local plain HTTP
# FSP_BIND_IP=127.0.0.1
# FSP_PORT=8080
# FSP_DB_PORT=5434
