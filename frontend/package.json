{
  "name": "@fsp/frontend",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "mock": "bun run --cwd ../mock-server start",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "bun --bun playwright test",
    "e2e:public": "bun --bun playwright test -c playwright.public.config.ts",
    "lint": "biome check . && bun scripts/check-layers.ts",
    "format": "biome format --write .",
    "codegen": "bun run --cwd ../contracts/codegen generate",
    "codegen:check": "bun run --cwd ../contracts/codegen check",
    "verify": "bun run codegen:check && bun run typecheck && bun run lint && bun run test && bun run build && bun scripts/check-bundle.ts"
  },
  "dependencies": {
    "@openobserve/browser-rum": "0.4.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@xyflow/react": "12.12.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "msw": "3.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
